# frozen_string_literal: true

# Fastfile for Aria
# Lanes for building, testing, and quality-checking the Aria Swift package
# and the Avyra iOS app (the sample app that ships on top of the package).
#
# Usage examples:
#   bundle exec fastlane package_build      # swift build
#   bundle exec fastlane package_tests      # swift test (all targets)
#   bundle exec fastlane core_tests         # swift test --filter AriaTests (Linux-safe)
#   bundle exec fastlane app_local_build       # build Avyra on iOS Simulator
#   bundle exec fastlane app_tests       # run Avyra tests on iOS Simulator
#   bundle exec fastlane lint               # SwiftLint
#   bundle exec fastlane lint fix:true      # SwiftLint --fix
#   bundle exec fastlane format             # SwiftFormat (in place)
#   bundle exec fastlane format lint:true   # SwiftFormat --lint (no writes)
#   bundle exec fastlane quality            # format --lint + lint
#   bundle exec fastlane ci_quality         # quality, CI-friendly
#   bundle exec fastlane ci_build_test      # package_tests + app_local_build + app_tests
#   bundle exec fastlane clean              # clear build artifacts

default_platform(:ios)

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

PROJECT_ROOT = File.expand_path("..", __dir__)
APP_PROJECT = File.join(PROJECT_ROOT, "Apps/AvyraApp/Avyra.xcodeproj")
APP_SCHEME = "Avyra"
DEFAULT_SIMULATOR = "iPhone 17"

# Paths SwiftFormat / SwiftLint should cover (relative to repo root).
QUALITY_PATHS = [
  "Sources",
  "Tests",
  "Apps/AriaCLI",
  "Apps/AvyraApp/Avyra",
  "Apps/AvyraApp/AvyraTests",
  "Apps/AvyraApp/AvyraUITests"
].freeze

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def in_root(command)
  sh("cd '#{PROJECT_ROOT}' && #{command}")
end

def simulator_destination(options, prefer_generic: false)
  if options[:id]
    "platform=iOS Simulator,id=#{options[:id]}"
  elsif options[:device]
    "platform=iOS Simulator,name=#{options[:device]}"
  elsif prefer_generic
    "generic/platform=iOS Simulator"
  else
    "platform=iOS Simulator,name=#{DEFAULT_SIMULATOR}"
  end
end

def quality_paths_string
  QUALITY_PATHS.map { |p| "\"#{File.join(PROJECT_ROOT, p)}\"" }.join(" ")
end

# SwiftFormat helper. Called by both the `format` lane and the
# `quality`/`ci_quality` aggregator lanes. Lives outside the lanes
# because the lane is named `format`, which collides with Ruby's
# built-in `Kernel#format`: calling `format(...)` from inside another
# lane resolves to `Kernel.format` (printf), not the Fastlane lane,
# and explodes with "no implicit conversion of Hash into String".
# The helper sidesteps the collision entirely.
def run_swiftformat(lint:, verbose: false)
  config = File.join(PROJECT_ROOT, ".swiftformat")
  extra = []
  extra << "--lint" if lint
  extra << "--verbose" if verbose

  cmd = ["swiftformat", quality_paths_string, "--config", "\"#{config}\"", *extra].join(" ")

  UI.message("Running SwiftFormat#{lint ? ' (lint)' : ''}...")

  begin
    sh(cmd)
    UI.success("SwiftFormat passed")
  rescue StandardError
    if lint
      UI.user_error!("SwiftFormat found formatting issues")
    else
      raise
    end
  end
end

# SwiftLint helper. Mirrors `run_swiftformat`; the `lint` lane and
# aggregator lanes both delegate here. `lint` doesn't collide with
# any Kernel method, but the symmetry keeps the file consistent and
# means the aggregator lanes never call other lanes (no risk of the
# Ruby 3.2 keyword-args / Hash interop weirdness Fastlane's lane
# runner has).
def run_swiftlint(fix:, strict: false)
  config = File.join(PROJECT_ROOT, ".swiftlint.yml")
  mode = fix ? "--fix" : "lint"
  strict_flag = strict ? " --strict" : ""

  UI.message("Running SwiftLint#{fix ? ' (fix)' : ''}...")

  begin
    sh("swiftlint #{mode} #{quality_paths_string} --config \"#{config}\"#{strict_flag}")
    UI.success("SwiftLint passed")
  rescue StandardError
    if strict
      UI.user_error!("SwiftLint failed in strict mode")
    else
      UI.important("SwiftLint reported violations")
    end
  end
end

# ---------------------------------------------------------------------------
# Swift Package lanes
# ---------------------------------------------------------------------------

platform :ios do
  desc "Build the Swift package (all targets)"
  lane :package_build do
    in_root("swift build")
    UI.success("Swift package build complete")
  end

  desc "Run all Swift package tests"
  lane :package_tests do
    in_root("swift test")
    UI.success("Swift package tests passed")
  end

  desc "Run only the platform-agnostic core tests (Linux-safe)"
  lane :core_tests do
    in_root("swift test --filter AriaTests")
    UI.success("Core tests passed")
  end

  desc "Run the CLI demo (`swift run AriaCLI`)"
  lane :cli_demo do
    in_root("swift run AriaCLI")
  end

  # -----------------------------------------------------------------------
  # Avyra (Xcode) lanes
  # -----------------------------------------------------------------------

  desc "Build Avyra for iOS Simulator"
  desc "Options:"
  desc "  device:'iPhone 17'   - Simulator by name"
  desc "  id:'<uuid>'          - Simulator by UDID"
  desc "  clean:true           - Clean before building"
  desc ""
  desc "With no device/id, builds against the generic iOS Simulator"
  desc "destination — works on any Mac (including CI runners) without"
  desc "requiring a specific simulator to be installed. Tests need a"
  desc "real named simulator; pass device:'iPhone 17 Pro' or id:'<uuid>'"
  desc "to target one for local debug runs."
  lane :app_local_build do |options|
    destination = simulator_destination(options, prefer_generic: true)
    UI.message("Building Avyra for: #{destination}")

    xcodebuild(
      project: APP_PROJECT,
      scheme: APP_SCHEME,
      configuration: "Debug",
      destination: destination,
      build: true,
      clean: options[:clean] || false,
      xcargs: "CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO"
    )

    UI.success("Avyra build complete")
  end

  desc "Run Avyra tests on iOS Simulator"
  desc "Options: device, id, clean — same as app_local_build"
  lane :app_tests do |options|
    destination = simulator_destination(options)
    UI.message("Testing Avyra on: #{destination}")

    run_tests(
      project: APP_PROJECT,
      scheme: APP_SCHEME,
      destination: destination,
      clean: options[:clean] || false,
      code_coverage: true
    )

    UI.success("Avyra tests passed")
  end

  # -----------------------------------------------------------------------
  # Code quality lanes
  # -----------------------------------------------------------------------

  desc "Run SwiftLint across Aria sources"
  desc "Options:"
  desc "  fix:true     - Auto-correct violations where possible"
  desc "  strict:true  - Fail on warnings (default: false)"
  lane :lint do |options|
    run_swiftlint(fix: options[:fix] || false, strict: options[:strict] || false)
  end

  desc "Run SwiftFormat across Aria sources"
  desc "Options:"
  desc "  lint:true     - Check only, do not modify files"
  desc "  verbose:true  - Show detailed output"
  lane :format do |options|
    run_swiftformat(lint: options[:lint] || false, verbose: options[:verbose] || false)
  end

  desc "Run all code-quality checks (format --lint + lint)"
  desc "Options: fix:true to auto-fix both"
  lane :quality do |options|
    # Aggregator lanes call the helpers directly rather than
    # invoking sibling lanes — see comment on `run_swiftformat`
    # for the Kernel#format collision that made the lane-to-lane
    # path unusable.
    if options[:fix]
      run_swiftformat(lint: false)
      run_swiftlint(fix: true)
    else
      run_swiftformat(lint: true)
      run_swiftlint(fix: false)
    end

    UI.success("All quality checks complete")
  end

  # -----------------------------------------------------------------------
  # CI lanes
  # -----------------------------------------------------------------------

  desc "CI: build and test everything (package + app)"
  lane :ci_build_test do
    # Receiver lanes that declare `do |options|` need an explicit
    # hash so Ruby 3.2+ doesn't refuse the call. Lanes without an
    # options block (like `package_tests`) accept the empty hash
    # silently, so passing `{}` everywhere is uniform and safe.
    package_tests
    app_local_build({})
    app_tests({})
  end

  desc "CI: format check + lint"
  lane :ci_quality do
    # Same helper-direct pattern as :quality. See `run_swiftformat`
    # for why we don't go through the sibling lane.
    run_swiftformat(lint: true)
    run_swiftlint(fix: false, strict: false)
  end

  # -----------------------------------------------------------------------
  # Utilities
  # -----------------------------------------------------------------------

  desc "Clear build artifacts"
  lane :clean do
    in_root("rm -rf .build .swiftpm/.build Apps/AvyraApp/build")
    clear_derived_data
    UI.success("Build artifacts cleaned")
  end
end
